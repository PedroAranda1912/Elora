# Copie este arquivo para backend/.env e substitua pela URI PostgreSQL do Aiven.
# A URI deve conter usuário e senha, por exemplo: postgres://USUARIO:SENHA@HOST:PORTA/defaultdb?sslmode=require
DB_URL=postgres://USUARIO:SENHA@HOST:PORTA/defaultdb?sslmode=require

# Gere um segredo aleatório forte com pelo menos 32 bytes.
JWT_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_FORTE_AQUI

# Brevo (opcional). Cadastre e verifique este remetente na conta Brevo.
ELORA_BREVO_API_KEY=
ELORA_BREVO_SENDER_EMAIL=
ELORA_BREVO_SENDER_NAME=Elora
